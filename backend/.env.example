# Copy to .env and adjust. The application will not start without SECRET_KEY
# and DATABASE_URL — this is deliberate, so it can never boot with a known key.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-generated-secret

# SQLite file, relative to the backend/ directory.
DATABASE_URL=sqlite:///./app.db

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------

# "development" enables the demo role-switcher endpoint. Any other value
# disables it. Never set this to "development" on a public deployment.
APP_ENV=development

# Comma-separated. Vite's dev server defaults to port 5173.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Month (1-12) on which the academic year rolls over. July by default.
ACADEMIC_YEAR_START_MONTH=7

# Where uploaded documents are written (Phase 3). Keep outside any served path.
STORAGE_ROOT=./var/uploads

# Fixed seed so the demo dataset is reproducible.
SEED_RANDOM_SEED=20260807
